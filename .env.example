# Postgres connection string
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Discord OAuth (https://discord.com/developers/applications → OAuth2)
# Redirect: https://โดเมนของคุณ/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SITE_URL=https://flexozy.site

# Discord ID ของแอดมิน (คั่นด้วยคอมมา)
ADMIN_DISCORD_IDS=123456789012345678

# ลิงก์เข้าหลังบ้าน = https://โดเมน/<ADMIN_PATH>  (a-z 0-9 - _ ยาว 6–40 ตัว)
ADMIN_PATH=fx-panel-k7q2m9x4

# 0 = ปิดระบบกัน DevTools / คีย์ลัด (ค่าเริ่มต้นเปิดเฉพาะ production)
NEXT_PUBLIC_GUARD=1

# --- ระบบแบนชั่วคราว (หลังบ้าน) ไม่ต้องตั้งค่าเพิ่ม ---
# คนที่ไม่ใช่แอดมินเข้าลิงก์หลังบ้าน = ปฏิเสธ + แบน IP/บัญชี 15 นาที (ผิดซ้ำ x2 สูงสุด 24 ชม.) ปลดได้ที่แท็บ "ตั้งค่า"
# --- Heartbeat เตะผู้เล่น --- ดู docs/nexus-client.lua (เรียก /api/keys/heartbeat ทุก ~10 วิ)
